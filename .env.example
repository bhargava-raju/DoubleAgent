# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Anthropic API (https://console.anthropic.com)
PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# The agent targets Claude Sonnet for now.
# MODEL=claude-sonnet-5-5
# MAX_TOKENS=16000

# Logging: DEBUG, INFO (default), WARNING or ERROR. DEBUG also shows the SDK's HTTP logs.
# LOG_LEVEL=INFO

# Microsoft Foundry (Azure) is deferred until the agent works end to end with Sonnet.
# PROVIDER=foundry
# ANTHROPIC_FOUNDRY_API_KEY=...          # Foundry portal: your resource > Keys and Endpoint
# ANTHROPIC_FOUNDRY_RESOURCE=my-resource # from https://my-resource.services.ai.azure.com
# MODEL=claude-sonnet-5-5                # your Claude *deployment name* in Foundry
