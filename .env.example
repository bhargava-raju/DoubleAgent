# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Option A: Anthropic API (https://console.anthropic.com)
PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Option B: Microsoft Foundry (Azure). Deploy a Claude model in your Foundry resource first.
# PROVIDER=foundry
# ANTHROPIC_FOUNDRY_API_KEY=...          # Foundry portal: your resource > Keys and Endpoint
# ANTHROPIC_FOUNDRY_RESOURCE=my-resource # from https://my-resource.services.ai.azure.com
# MODEL=claude-sonnet-5-5                # your Claude *deployment name* in Foundry

# MODEL=claude-opus-5-5
# MAX_TOKENS=16000
